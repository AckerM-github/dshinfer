# Copy to .env and adjust the paths for your machine.

DSHINFER_LOG_LEVEL=info

# mock | llamacpp
DSHINFER_ENGINE=llamacpp

# Folder scanned for *.gguf models.
DSHINFER_MODELS_DIR=D:\llm\models\gguf

# Total context. With --kv-unified a single long request may use all of it.
DSHINFER_N_CTX=65536

# KV cache quantisation (f16 | q8_0 | q4_0 ...).
# q8_0 halves KV bytes per token, so 64K fits in the same VRAM as 32K at f16.
DSHINFER_CACHE_TYPE_K=q8_0
DSHINFER_CACHE_TYPE_V=q8_0

# Slots share one unified KV pool, so extra slots cost no extra VRAM.
DSHINFER_N_PARALLEL=4
DSHINFER_MAX_CONCURRENCY=4
DSHINFER_KV_UNIFIED=true

# Prefill batch. 512 -> 1024 gave +10% on prefill; larger has diminishing returns.
DSHINFER_N_BATCH=2048
DSHINFER_N_UBATCH=1024
DSHINFER_FLASH_ATTN=true

# Pin a session to one slot so its prompt cache keeps hitting.
DSHINFER_SLOT_PINNING=true

# Keep reasoning out of `content` (it goes to `reasoning_content`).
DSHINFER_ENABLE_THINKING=false
