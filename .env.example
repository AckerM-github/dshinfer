# 本机路径覆盖模板 —— 复制成 .env（.env 不进 git）
#
# 调优参数不在这里抄！它们只有一份：config/base.env（容器与原生自动加载）。
# 这个文件只负责「这台机器的路径」，其余留空即可。
#
# 容器里不用这个文件（容器用的是 config/docker.env）。

# 权重目录：注册表扫描这里的 *.gguf
DSHINFER_MODELS_DIR=D:\llm\models\gguf

# 默认加载哪一个 GGUF
DSHINFER_GGUF_PATH=D:\llm\models\gguf\DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic.Q4_K_M.gguf

# llama-server 可执行文件
DSHINFER_LLAMA_SERVER_PATH=D:\llm\runtime\llama.cpp\llama-server.exe

# 聊天模板（缺失时服务层退回朴素 ChatML）
DSHINFER_CHAT_TEMPLATE_PATH=D:\llm\runtime\chat_template.jinja

# 引擎日志
DSHINFER_ENGINE_LOG_PATH=D:\llm\runtime\llama-server.log
