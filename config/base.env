# dshinfer 统一配置契约 —— 与机器无关的调优参数，三种形态共用一份
#
# 谁读它：
#   docker compose    → docker/compose.yaml 的 env_file（容器 / 云）
#   Windows 原生跑    → src/dshinfer/config.py 自动加载仓库里的这份
#   Linux 原生跑      → 同上
#
# 这里只许写「调优参数」：上下文、KV 量化、并发、调度、思考模式。
# 跟机器绑定的东西一律不写在这里：
#   容器内路径 → config/docker.env
#   宿主机路径 → 本机 .env（不进 git，模板见 .env.example）
#
# 优先级（高到低）：进程环境变量 > 本机 .env > 本文件 > config.py 里的平台默认值。
# 改完这里，容器要 up --build 重建（env_file 在创建容器时展开）。

# 引擎选择（默认 inproc）：
#   inproc   = 进程内（vendor/llama_cpp → llama.dll），单流省 20–30 ms，但**并发 1**、只记得上一条 KV
#   llamacpp = 子进程 llama-server，4 slot + kv_unified，多会话前缀缓存命中 87–97%
#   mock     = 不真出 token，测试与压测用
# 判据：一个人对话、在乎首字延迟 → inproc；多会话并行、在乎总吞吐 → llamacpp。
# 容器里会被 config/docker.env 覆盖回 llamacpp，原因见那份文件。
DSHINFER_ENGINE=inproc

# 上下文总额。kv_unified=true 时这是「单个请求最多能用多少」，不是四个人分。
# 64K + q8_0 KV：实测显存 6,727 MiB / 8,188 MiB，--fit off 之后 pp/tg 与 32K 无差别。
# 小显存卡（<8 GB）先降到 32768。
DSHINFER_N_CTX=65536
DSHINFER_CACHE_TYPE_K=q8_0
DSHINFER_CACHE_TYPE_V=q8_0

# 4 个 slot 共享一个 KV 池：4 路并发聚合 110 tok/s（单流 42）。
DSHINFER_N_PARALLEL=4
DSHINFER_MAX_CONCURRENCY=4
DSHINFER_KV_UNIFIED=true

# 预填充批：512 -> 1024 快约 10%，再往上收益消失、显存线性涨。
DSHINFER_N_BATCH=2048
DSHINFER_N_UBATCH=1024
DSHINFER_FLASH_ATTN=true

# 把会话钉在固定 slot 上，多步对话的前缀缓存命中率 0% -> 100%。
DSHINFER_SLOT_PINNING=true

# -1 = 全部层放 GPU。
DSHINFER_N_GPU_LAYERS=-1

# llama.cpp 的 --fit 自动降配：显存不够时偷偷少 offload 且不报错（64K 时 tg 掉 36%）。
# 关掉 = 装不下就显式失败。显存更小的卡如果加载 OOM，把这里改成 true。
DSHINFER_FIT=false

# True = 思考过程混在正文里；False = 直接给答案（思考放到 reasoning_content）。
DSHINFER_ENABLE_THINKING=false

DSHINFER_LOG_LEVEL=info
