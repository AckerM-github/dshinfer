# dshinfer 统一配置契约 —— 与机器无关的调优参数，三种形态共用一份
#
# 谁读它：
#   docker compose     → docker/compose.yaml 的 env_file（容器 / 云）
#   Windows 原生路径    → src/dshinfer/config.py 自动加载仓库里的这份
#   Linux 原生路径      → 同上
#
# 这里只许写「调优参数」：上下文、KV 量化、并发、调度、思考模式。
# 跟机器绑定的东西一律不写在这里：
#   容器内路径 → config/docker.env
#   宿主机路径 → 本机 .env（不进 git，模板见 .env.example）
#
# 优先级（高到低）：进程环境变量 > 本机 .env > 本文件 > config.py 里的平台默认值。

# 引擎选择（默认 inproc）：
#   inproc = 进程内（vendor/llama_cpp → llama.dll），单流省 20–30 ms，但并发 1
#   mock   = 不真出 token，测试与压测用
DSHINFER_ENGINE=inproc

# 上下文总额：单个请求最多能用多少（进程中只有一个 context）。
# 64K + q8_0 KV：实测显存 6,727 MiB / 8,188 MiB，pp/tg 与 32K 无差别。
# 小显存卡（<8 GB）先降到 32768。
DSHINFER_N_CTX=65536
DSHINFER_CACHE_TYPE_K=q8_0
DSHINFER_CACHE_TYPE_V=q8_0

# 并发上限。进程内引擎只有一把 decode 锁，>1 只会让请求一起排队：
# 吞吐不变、尾延迟变差。要真并发得给每个请求配一个 llama_context。
DSHINFER_N_PARALLEL=1
DSHINFER_MAX_CONCURRENCY=1

# 预填充批：512 -> 1024 快约 10%，再往上收益消失、显存线性涨。
DSHINFER_N_BATCH=2048
DSHINFER_N_UBATCH=1024
DSHINFER_FLASH_ATTN=true

# -1 = 全部层放 GPU。
DSHINFER_N_GPU_LAYERS=-1

# True = 思考过程混在正文里；False = 直接给答案（思考放到 reasoning_content）。
DSHINFER_ENABLE_THINKING=false
