# 容器内路径 —— 只给 docker/compose.yaml 的 env_file 用（宿主原生跑不要用）
#
# 这些路径由 docker/Dockerfile 约定，改镜像布局时同步改这里：
#   引擎摊平到 /opt/llama          （engine 阶段）
#   权重挂到 /models:ro            （compose volumes）
#   聊天模板随镜像走               （/app/runtime/chat_template.jinja）
#   引擎日志进日志卷               （/var/log/dshinfer）

# 引擎覆盖：容器是 Linux，vendor/llama_cpp 带的是 Windows DLL（py3-none-win_amd64），
# 进程内引擎在这里起不来；镜像里摊平的 b12202 llama-server 才是可用路径。
# 哪天镜像里编好了 Linux 版 libllama.so 并与 vendor 的绑定对得上，再把这一行删掉。
DSHINFER_ENGINE=llamacpp

DSHINFER_MODELS_DIR=/models
DSHINFER_GGUF_PATH=/models/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic.Q4_K_M.gguf
DSHINFER_LLAMA_SERVER_PATH=/opt/llama/bin/llama-server
DSHINFER_CHAT_TEMPLATE_PATH=/app/runtime/chat_template.jinja
DSHINFER_ENGINE_LOG_PATH=/var/log/dshinfer/llama-server.log
DSHINFER_HOST=0.0.0.0
DSHINFER_PORT=8000
DSHINFER_ENGINE_START_TIMEOUT_S=300
